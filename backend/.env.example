APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/app.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300
REQUIRE_EXTERNAL_PERSISTENCE=false
JOB_EXECUTION_MODE=background
DATA_ROOT=./data
STORAGE_BACKEND=local
STORAGE_CACHE_ROOT=/tmp/datatrace-storage-cache
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=datatrace
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=
MAX_UPLOAD_BYTES=524288000
AUTH_MODE=dev_token
DEV_AUTH_TOKEN=local-development-token
JWT_SECRET=replace-in-non-development
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ai-data-analyst
JWT_ISSUER=ai-data-analyst
REGISTRATION_ENABLED=true
SESSION_COOKIE_NAME=datatrace_session
CSRF_COOKIE_NAME=datatrace_csrf
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Optional OpenAI-compatible LLM. Core analysis remains available when disabled.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_OUTPUT_MODE=json_schema
# Optional provider-specific control. Leave empty when the endpoint does not support it.
LLM_ENABLE_THINKING=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_CALLS_PER_TURN=4
LLM_MAX_TOOL_CALLS_PER_TURN=8
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET_PER_USER=200000
LLM_ALLOW_MASKED_SAMPLES=false
LLM_RETENTION_DAYS=30
