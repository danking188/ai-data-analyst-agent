{
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:7860 {
		# The single Uvicorn process closes idle upstream sockets quickly. Avoid
		# replay-unsafe POST failures when Caddy selects a stale pooled socket.
		transport http {
			keepalive off
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
