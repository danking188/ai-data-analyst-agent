{
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:7860 {
		# Keep the proxy idle window below Uvicorn's 75-second keep-alive. Disabling
		# pooling entirely caused intermittent EOFs while streaming POST bodies.
		transport http {
			keepalive 30s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
