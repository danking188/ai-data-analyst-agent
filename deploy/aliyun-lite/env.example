# DNS must point this hostname to the server public IPv4 before first start.
DOMAIN=analytics.example.com

APP_ENV=production
API_PREFIX=/api/v1
PORT=7860
DATABASE_URL=sqlite:////mnt/workspace/data/app.db
REQUIRE_EXTERNAL_PERSISTENCE=false
JOB_EXECUTION_MODE=worker
DATA_ROOT=/mnt/workspace/data
STORAGE_BACKEND=local
STORAGE_CACHE_ROOT=/tmp/datatrace-storage-cache
MAX_UPLOAD_BYTES=104857600

AUTH_MODE=jwt
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ai-data-analyst
JWT_ISSUER=ai-data-analyst
LOGIN_USERNAME=analyst
LOGIN_PASSWORD=replace-with-a-strong-password
REGISTRATION_ENABLED=false
SESSION_COOKIE_NAME=datatrace_session
CSRF_COOKIE_NAME=datatrace_csrf
CSRF_MODE=double_submit
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200

# Repeat DOMAIN here exactly; env-file values are deliberately explicit.
CORS_ORIGINS=https://analytics.example.com
TRUSTED_HOSTS=analytics.example.com,127.0.0.1,app

LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
# Qwen OpenAI-compatible deployments should use prompt mode and disable thinking
# so every Agent turn returns only the strict JSON object expected by the backend.
LLM_STRUCTURED_OUTPUT_MODE=prompt
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_CALLS_PER_TURN=4
LLM_MAX_TOOL_CALLS_PER_TURN=8
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET_PER_USER=50000
LLM_MAX_CONCURRENT_TURNS_PER_PROJECT=1
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
LLM_ALLOW_MASKED_SAMPLES=false
LLM_RETENTION_DAYS=30
LLM_ARCHIVE_INACTIVE_DAYS=90
# Leave empty to expose LLM features to every authenticated account. For a
# controlled canary, provide a comma-separated list of exact subject IDs.
LLM_CANARY_SUBJECTS=

IMAGE_TAG=local
DATATRACE_DATA_DIR=/opt/datatrace/data
DATATRACE_BACKUP_DIR=/opt/datatrace/backups
APP_MEMORY_LIMIT=1400m
APP_CPU_LIMIT=1.5
