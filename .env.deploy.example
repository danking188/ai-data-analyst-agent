APP_ENV=production
API_PREFIX=/api/v1

# Production should use an external PostgreSQL database with TLS enabled.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300
REQUIRE_EXTERNAL_PERSISTENCE=true
JOB_EXECUTION_MODE=worker
DATA_ROOT=./data

# S3-compatible object storage for uploads, versions, and generated artifacts.
STORAGE_BACKEND=s3
STORAGE_CACHE_ROOT=/tmp/datatrace-storage-cache
S3_BUCKET=replace-with-private-bucket
S3_ENDPOINT_URL=https://replace-with-s3-endpoint
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PREFIX=datatrace
S3_FORCE_PATH_STYLE=true
# Leave unset for providers such as Supabase Storage that reject this S3 header.
S3_SERVER_SIDE_ENCRYPTION=

MAX_UPLOAD_BYTES=524288000
AUTH_MODE=jwt
DEV_AUTH_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ai-data-analyst
JWT_ISSUER=ai-data-analyst
LOGIN_USERNAME=analyst
LOGIN_PASSWORD=replace-with-a-strong-login-password
REGISTRATION_ENABLED=true
SESSION_COOKIE_NAME=datatrace_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

# Browser origin that serves the frontend.
CORS_ORIGINS=http://localhost:8080

# Frontend build-time configuration.
VITE_API_BASE_URL=/api/v1
VITE_API_MODE=real

# Optional OpenAI-compatible LLM. Keep disabled until the provider values are configured.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://provider.example/v1
LLM_API_KEY=replace-with-provider-api-key
LLM_MODEL=replace-with-provider-model-name
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_CALLS_PER_TURN=4
LLM_MAX_TOOL_CALLS_PER_TURN=8
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET_PER_USER=200000
LLM_MAX_CONCURRENT_TURNS_PER_PROJECT=2
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
LLM_ALLOW_MASKED_SAMPLES=false
LLM_RETENTION_DAYS=30
LLM_ARCHIVE_INACTIVE_DAYS=90
# Optional comma-separated subject IDs for a production canary. Empty enables all signed-in users.
LLM_CANARY_SUBJECTS=

BACKEND_PORT=8000
FRONTEND_PORT=8080
