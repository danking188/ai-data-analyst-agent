APP_ENV=production
API_PREFIX=/api/v1

# Local single-node deployment uses SQLite persisted in the backend-data volume.
# For managed databases, set a SQLAlchemy-compatible URL and run migrations before traffic.
DATABASE_URL=sqlite:///./data/app.db
DATA_ROOT=./data

MAX_UPLOAD_BYTES=524288000
AUTH_MODE=jwt
DEV_AUTH_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ai-data-analyst
JWT_ISSUER=ai-data-analyst
LOGIN_USERNAME=analyst
LOGIN_PASSWORD=replace-with-a-strong-login-password
SESSION_COOKIE_NAME=datatrace_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

# Browser origin that serves the frontend.
CORS_ORIGINS=http://localhost:8080

# Frontend build-time configuration.
VITE_API_BASE_URL=/api/v1
VITE_API_MODE=real

BACKEND_PORT=8000
FRONTEND_PORT=8080
