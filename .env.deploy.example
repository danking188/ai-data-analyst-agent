APP_ENV=production
API_PREFIX=/api/v1

# Production should use an external PostgreSQL database with TLS enabled.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300
REQUIRE_EXTERNAL_PERSISTENCE=true
JOB_EXECUTION_MODE=worker
DATA_ROOT=./data

# S3-compatible object storage for uploads, versions, and generated artifacts.
STORAGE_BACKEND=s3
STORAGE_CACHE_ROOT=/tmp/datatrace-storage-cache
S3_BUCKET=replace-with-private-bucket
S3_ENDPOINT_URL=https://replace-with-s3-endpoint
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PREFIX=datatrace
S3_FORCE_PATH_STYLE=true
# Leave unset for providers such as Supabase Storage that reject this S3 header.
S3_SERVER_SIDE_ENCRYPTION=

MAX_UPLOAD_BYTES=524288000
AUTH_MODE=jwt
DEV_AUTH_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ai-data-analyst
JWT_ISSUER=ai-data-analyst
LOGIN_USERNAME=analyst
LOGIN_PASSWORD=replace-with-a-strong-login-password
REGISTRATION_ENABLED=true
SESSION_COOKIE_NAME=datatrace_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

# Browser origin that serves the frontend.
CORS_ORIGINS=http://localhost:8080

# Frontend build-time configuration.
VITE_API_BASE_URL=/api/v1
VITE_API_MODE=real

BACKEND_PORT=8000
FRONTEND_PORT=8080
